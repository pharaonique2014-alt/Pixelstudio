# ---------------------------------------------------------------------------
# RénoDevis — variables d'environnement (MODÈLE, aucune vraie valeur ici)
# Copier en .env.local pour le front. Les secrets serveur se déclarent dans
# Supabase : `supabase secrets set NOM=valeur` — jamais dans le dépôt.
# ---------------------------------------------------------------------------

# --- Front (public, intégré au build) ---------------------------------------
# URL de la fonction serveur. Vide en local = API simulée (code SMS 123456).
VITE_API_URL=https://[PROJET].supabase.co/functions/v1/public-api
# Clé de SITE Turnstile (publique). Test Cloudflare : 1x00000000000000000000AA
VITE_TURNSTILE_SITE_KEY=
# Pixels publicitaires : laisser vide = aucun traceur, aucun bandeau cookies.
VITE_META_PIXEL_ID=
VITE_GOOGLE_TAG_ID=

# --- Fonction serveur public-api (SECRETS) ----------------------------------
# SUPABASE_URL et SUPABASE_SERVICE_ROLE_KEY sont fournis automatiquement.
HASH_PEPPER=                 # 32+ caractères aléatoires : openssl rand -hex 32
TURNSTILE_SECRET_KEY=        # test Cloudflare : 1x0000000000000000000000000000000AA
BREVO_API_KEY=
SMS_SENDER=RenoDevis         # 11 caractères max
EMAIL_FROM=                  # expéditeur vérifié chez Brevo
ADMIN_NOTIFY_EMAIL=          # [À COMPLÉTER] votre adresse de notification
ALLOWED_ORIGINS=https://connect.pxlstudio.be
